;; EGRAPH_DUMP_PLAN=1 ./target/release/semi-persistent rampup/kata2/plan.egg

(sort B)
(sort I)

(function True () B)
(function Lt (I I) B)

(function Lit (IBig) I)
(function Add (I I) I)
(function Ite (B I I) I)
(function Clamp (I I I) I)

(let three (Lit 3))
(let ten (Lit 10))

(let c (Lt three ten))
(let t (Ite c three ten))

;; rewrite rules
(rewrite
    (Add x (Lit 0))
    x
)
(rewrite
    (Ite (True) x y)
    x
)

;; add terms that the rules can match
(let a (Add three (Lit 0)))

;; run equality saturation
(run 10)

;; section 2 union
(union c (True))

(run 10)